APP_URL=
VITE_APP_URL=

# Gemini AI (Server-Side)
GEMINI_API_KEY=

# Firebase Client
FIREBASE_API_KEY=

# WhatsApp Integration:
# WhatsApp Click-to-Chat (wa.me) works 100% out of the box with NO credentials, no Meta app, and no Facebook account needed.
# The following Meta Cloud API variables are completely OPTIONAL and not required:
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
